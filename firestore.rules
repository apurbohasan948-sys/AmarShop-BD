rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'apurbohasan948@gmail.com' || 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Settings Collection
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId && incoming().role == 'customer';
      allow update: if (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'email'])) || isAdmin();
    }

    // Wishlists Collection
    match /wishlists/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Products Collection
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();

      // Reviews Subcollection
      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isSignedIn() && incoming().userId == request.auth.uid;
        allow update, delete: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
      }
    }

    // Categories Collection
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Verified Transactions
    match /verified_transactions/{txId} {
      allow read: if isSignedIn();
      allow update: if isSignedIn() && 
        incoming().isUsed == true && 
        existing().isUsed == false &&
        incoming().diff(existing()).affectedKeys().hasOnly(['isUsed']);
      allow create, delete: if isAdmin();
    }

    // Orders Collection
    match /orders/{orderId} {
      allow read: if isSignedIn() && (isOwner(existing().customerUid) || isAdmin());
      allow create: if isSignedIn() && incoming().customerUid == request.auth.uid 
                    && incoming().paymentStatus == 'pending' 
                    && incoming().orderStatus == 'pending';
      allow update: if isAdmin() || (
        isSignedIn() && 
        isOwner(existing().customerUid) && 
        incoming().diff(existing()).affectedKeys().hasOnly(['paymentStatus', 'transactionId', 'updatedAt']) &&
        incoming().paymentStatus == 'verified'
      );
      allow delete: if false;
    }
  }
}
